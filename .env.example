# ==============================================================================
# CodeLens AI — Environment Configuration Template
# ==============================================================================

PROJECT_NAME="CodeLens AI — AI Codebase Intelligence Platform"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL + pgvector required for production)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codelens"

# Docker Compose PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelens

# ------------------------------------------------------------------------------
# Security & Network Settings
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins for CORS.
# For production, set to your frontend domain (e.g., https://app.codelens.ai)
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Authorized repository directory roots (path confinement).
# In production, restrict repository registration to dedicated storage mounts (e.g., /app/repos).
# Leave empty or unset only in trusted single-user local development mode.
ALLOWED_REPO_ROOTS=""

# ------------------------------------------------------------------------------
# Operational & Resource Limits
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=1000000     # Maximum file size for AST analysis (default: 1 MB)
MAX_FILES_PER_REPO=5000         # Maximum files indexed per repository to prevent resource exhaustion

# ------------------------------------------------------------------------------
# Embedding & Vector Search
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20

# ------------------------------------------------------------------------------
# LLM Evidence Grounding (Optional for deterministic trace, required for RAG/explain)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RAG_TOP_K_SEMANTIC=8
RAG_MAX_EVIDENCE_ITEMS=12
MAX_QUESTION_LENGTH=1000

# ------------------------------------------------------------------------------
# Architecture Intelligence Trace
# ------------------------------------------------------------------------------
ARCHITECTURE_TRACE_MAX_DEPTH=8
ARCHITECTURE_TRACE_MAX_NODES=20

# ------------------------------------------------------------------------------
# Frontend Settings (Used during Next.js build / client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
